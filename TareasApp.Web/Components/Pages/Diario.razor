@page "/reflexion"
@rendermode InteractiveServer
@using TareasApp.Application.Services
@using TareasApp.Domain;
@inject ReflexionService ReflexionService

<div class="container-fluid px-5 py-4">
    <div class="row">
        <div class="col-12">
            
            <header class="mb-5 pb-4 border-bottom">
                <h2 class="display-4 fw-bold text-dark mb-2">Reflexión Diaria</h2>
                <p class="text-muted fs-4">Un momento para pausar, agradecer y crecer.</p>
            </header>

            <section class="mb-5">
                <h5 class="mb-4 text-secondary fw-semibold">¿Cómo te sientes hoy?</h5>
                <div class="d-flex justify-content-between gap-4">
                    @foreach (var mood in moods)
                    {
                        <button class="btn btn-lg @(selectedMood == mood.Emoji ? "btn-primary shadow" : "btn-light border") 
                                       rounded-4 p-4 d-flex flex-column align-items-center flex-fill transition-all" 
                                @onclick="() => selectedMood = mood.Emoji">
                            <span class="fs-1 mb-2">@mood.Emoji</span>
                            <span class="fw-medium">@mood.Label</span>
                        </button>
                    }
                </div>
            </section>

            <article class="card border-0 shadow-sm p-5 rounded-4">
                <header class="d-flex justify-content-between align-items-center mb-4">
                <InputFile OnChange="CargarImagen" accept="image/*" class="d-none" id="inputImagen" />
                <label for="inputImagen" class="btn btn-outline-secondary rounded-pill px-4 py-2" style="cursor:pointer">
                <i class="bi bi-image me-2"></i>Subir Imagen</label>
                    <span class="text-muted small px-3">@DateTime.Now.ToString("dd MMMM, yyyy")</span>
                </header>
                
                <textarea class="form-control border-0 bg-light p-4 fs-5" rows="12"
                        @bind="texto" 
                          placeholder="Escribe aquí tu reflexión..."
                          style="resize: none; border-radius: 1rem;"></textarea>
                
                <footer class="d-flex justify-content-end mt-4 pt-4 border-top">
                    <button class="btn btn-primary btn-lg rounded-pill px-5 shadow"
                            @onclick="GuardarReflexion">
                        Guardar Reflexión
                    </button>
                </footer>
            </article>

    <section class="mt-5">
        <h5 class="mb-4 text-secondary fw-semibold">Reflexiones anteriores</h5>
        @foreach (var item in reflexiones)
        {
    <div class="card border-0 shadow-sm rounded-4 mb-3 p-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <span class="fs-2">@item.Sentimientos</span>
            <span class="text-muted small">@item.Fecha.ToString("dd MMMM, yyyy")</span>
        </div>
        <p class="fs-5 text-dark mb-3">@item.Pensamientos</p>
        @if (!string.IsNullOrEmpty(item.ImagenUrl))
        {
            <img src="@item.ImagenUrl" class="img-fluid rounded-3" style="max-height: 300px; object-fit: cover;" />
        }
    </div>
    }
    </section>

        </div>
    </div>
</div>

@code {
    private string selectedMood = "";
    private string texto = "";
    private string imagenUrl = "";
    private Reflexion reflexion = new Reflexion();
    private List<Reflexion> reflexiones = new();

    private List<(string Emoji, string Label)> moods = new() {
        ("😊", "Feliz"), ("😐", "Neutral"), ("😴", "Cansado"), ("🤯", "Estresado"), ("🥳", "Entusiasta"), ("🤔", "Reflexivo")
    };

    public async Task GuardarReflexion()
    {
        try{
            reflexion.Id = MongoDB.Bson.ObjectId.GenerateNewId().ToString();
            reflexion.Fecha = DateTime.Now;
            reflexion.Sentimientos = selectedMood;
            reflexion.Pensamientos = texto;
            reflexion.ImagenUrl = imagenUrl;

            await ReflexionService.ValidarReflexion(reflexion);
            reflexiones = await ReflexionService.ObtenerReflexiones();
            Console.WriteLine("Reflexión guardada exitosamente.");

            selectedMood = "";
            texto = "";
            imagenUrl = "";

        }catch(Exception ex)
        {
            Console.WriteLine($"Error al guardar la reflexión: {ex.Message}");
        }

    }

    private async Task CargarImagen(InputFileChangeEventArgs e)
    {
        var archivo = e.File;
        var stream = archivo.OpenReadStream(maxAllowedSize: 10485760);
        imagenUrl = await ReflexionService.SubirImagen(stream, archivo.Name);
    }

        protected override async Task OnInitializedAsync()
    {
        reflexiones = await ReflexionService.ObtenerReflexiones();
        Console.WriteLine($"Reflexiones obtenidas: {reflexiones.Count}");
    }
    //OnInitializedAsync Correcto — es como el useEffect(() => {}, [])


}